# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
TRUST_PROXY=false
DATABASE_PATH=./data/trading.db

# Dashboard auth - REQUIRED in production
ADMIN_PASSWORD=change-this-long-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Binance USD-M Futures
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://fapi.binance.com

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Safety gates
# Keep false until dry-run + approval mode have been tested.
ALLOW_LIVE_TRADING=false
DRY_RUN=true

# Worker intervals
POSITION_POLL_MS=3000
SCAN_INTERVAL_MS=60000

# Risk day boundary. 180 = Asia/Riyadh (UTC+3)
RISK_DAY_UTC_OFFSET_MINUTES=180
